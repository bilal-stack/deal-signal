# Copy to .env and fill in. .env is git-ignored.

# --- Required ---
ANTHROPIC_API_KEY=sk-ant-...

# --- Database (defaults match docker-compose) ---
DATABASE_URL=postgresql+asyncpg://dealsignal:dealsignal@localhost:5433/dealsignal
REDIS_URL=redis://localhost:6380/0

# --- Application ---
ENVIRONMENT=local
LOG_LEVEL=INFO
LOG_FORMAT=console
# Comma-separated. Only for a frontend served from another origin.
API_CORS_ORIGINS=

# --- Optional data sources ---
# Free key: https://developer.company-information.service.gov.uk (UK companies only)
COMPANIES_HOUSE_API_KEY=

# --- Crawler manners ---
CRAWLER_USER_AGENT=DealSignalBot/0.1 (+https://github.com/bilal-stack/deal-signal)
CRAWLER_REQUESTS_PER_DOMAIN_PER_SECOND=1
CRAWLER_MAX_PAGES_PER_SITE=6
